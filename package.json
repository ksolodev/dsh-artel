{
  "name": "dsh-artel",
  "version": "0.13.0",
  "description": "Run coding agents in a separate copy of your project: Solo, Swarm, Conductor, Fusion or Orchestrator — queue tasks for an unattended night shift, run the ticket Factory from incoming request to ready pull request, review the changes and apply them yourself.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksolodev/dsh-artel.git"
  },
  "homepage": "https://github.com/ksolodev/dsh-artel#readme",
  "bugs": {
    "url": "https://github.com/ksolodev/dsh-artel/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "lib/client.js",
    "lib/index.js",
    "lib/conductor.js",
    "lib/models.js",
    "lib/*.js",
    "cordis.patch.yml",
    "docs/*.md",
    "docs/*.svg",
    "docs/artel-in-chat/screens/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "deepseek-harness",
    "coding-agent",
    "multi-agent",
    "swarm",
    "conductor",
    "fusion",
    "orchestrator",
    "auto-queue",
    "night-shift",
    "factory",
    "tickets",
    "pipeline",
    "multi-model",
    "debate",
    "code-review",
    "ai-agents"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
